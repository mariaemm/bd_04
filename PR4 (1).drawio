        <mxCell id="eHWalvFC3gnGMFxf9oVd-125" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=#66B2FF;fontStyle=1" value="M" vertex="1">
          <mxGeometry height="20" width="22" x="468.74" y="953" as="geometry" />
        </mxCell>
        <mxCell id="eHWalvFC3gnGMFxf9oVd-126" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=#66B2FF;fontStyle=1" value="1" vertex="1">
          <mxGeometry height="20" width="22" x="426.24" y="953" as="geometry" />
        </mxCell>
        <mxCell id="eHWalvFC3gnGMFxf9oVd-128" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=9;spacing=0;" value="&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;PERTENECE&lt;/strong&gt; las dos líneas son dobles, y por la razón que dices: B6 dice “todo comercial está en un área y toda área tiene algún comercial”.&lt;/p&gt;&lt;br&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;COMERCIAL ═══ PERTENECE&lt;/strong&gt;: línea doble. No puede existir un comercial sin área.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;ÁREA ═══ PERTENECE&lt;/strong&gt;: línea doble. No puede existir un área sin ningún comercial&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="168" width="410" x="907" y="50" as="geometry" />
        </mxCell>
        <mxCell id="eHWalvFC3gnGMFxf9oVd-129" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=9;spacing=0;" value="&lt;p&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot; style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none;&quot;&gt;&lt;font&gt;Cardinalidad: ¿máximo cuántos? (B1 a B5)&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul dir=&quot;ltr&quot; style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none;&quot;&gt;&lt;font&gt;Participación: ¿mínimo cero o mínimo uno? (B6 a B9)&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="290" x="917" y="190" as="geometry" />
        </mxCell>
        <mxCell id="eHWalvFC3gnGMFxf9oVd-130" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=9;" value="&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;B6, PERTENECE (Comercial–Área)&lt;/strong&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;font&gt;&lt;u&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0.9); font-family: anthropic-sans, system-ui, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, &amp;quot;PingFang SC&amp;quot;, &amp;quot;PingFang TC&amp;quot;, &amp;quot;Hiragino Sans&amp;quot;, &amp;quot;Apple SD Gothic Neo&amp;quot;, &amp;quot;Kohinoor Devanagari&amp;quot;, &amp;quot;Kohinoor Bangla&amp;quot;, &amp;quot;Kohinoor Telugu&amp;quot;, &amp;quot;Tamil Sangam MN&amp;quot;, &amp;quot;Kohinoor Gujarati&amp;quot;, &amp;quot;Malayalam Sangam MN&amp;quot;, &amp;quot;Nirmala UI&amp;quot;, &amp;quot;Noto Sans Devanagari UI&amp;quot;, &amp;quot;Noto Sans Devanagari&amp;quot;, &amp;quot;Noto Sans Bengali UI&amp;quot;, &amp;quot;Noto Sans Bengali&amp;quot;, &amp;quot;Noto Sans Telugu UI&amp;quot;, &amp;quot;Noto Sans Telugu&amp;quot;, &amp;quot;Noto Sans Tamil UI&amp;quot;, &amp;quot;Noto Sans Tamil&amp;quot;, &amp;quot;Noto Sans Gujarati UI&amp;quot;, &amp;quot;Noto Sans Gujarati&amp;quot;, &amp;quot;Noto Sans Kannada UI&amp;quot;, &amp;quot;Noto Sans Kannada&amp;quot;, &amp;quot;Noto Sans Malayalam UI&amp;quot;, &amp;quot;Noto Sans Malayalam&amp;quot;, Thonburi, &amp;quot;Leelawadee UI&amp;quot;, &amp;quot;Noto Sans Thai UI&amp;quot;, &amp;quot;Noto Sans Thai&amp;quot;, Kefa, Ebrima, &amp;quot;Noto Sans Ethiopic&amp;quot;, &amp;quot;Abyssinica SIL&amp;quot;, sans-serif, ui-sans-serif, system-ui, -apple-system, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;PingFang SC&amp;quot;, &amp;quot;PingFang TC&amp;quot;, &amp;quot;Hiragino Sans&amp;quot;, &amp;quot;Apple SD Gothic Neo&amp;quot;, sans-serif; white-space: pre-wrap;&quot;&gt;Todo comercial está en un área y toda área tiene algún comercial&lt;/span&gt;&lt;br&gt;&lt;/u&gt;&lt;/font&gt;&lt;li&gt;¿Puede existir un comercial sin área? &lt;strong&gt;No&lt;/strong&gt; (“todo comercial está en un área”) → línea doble en COMERCIAL.&lt;/li&gt;&lt;li&gt;¿Puede existir un área sin comerciales? &lt;strong&gt;No&lt;/strong&gt; (“toda área tiene algún comercial”) → línea doble en ÁREA.&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;B7, ASIGNAR (Comercial–Cliente)&lt;/strong&gt;&lt;/p&gt;&lt;u style=&quot;&quot;&gt;Todo cliente tiene un comercial asignado, pero no todo comercial tiene cliente&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;¿Puede existir un cliente sin comercial? &lt;strong&gt;No&lt;/strong&gt; → línea doble en CLIENTE. a asignar&lt;/li&gt;&lt;li&gt;¿Puede existir un comercial sin clientes? &lt;strong&gt;Sí&lt;/strong&gt; (“no todo comercial tiene cliente”) → línea simple en COMERCIAL. a asignar&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;B8, RESPONSABLE (Comercial–Área)&lt;/strong&gt;&lt;/p&gt;&lt;u&gt;Toda área tiene como jefe a un comercial, pero no todos los comerciales son&lt;br/&gt;jefes de área.&lt;/u&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;¿Puede existir un área sin jefe? &lt;strong&gt;No&lt;/strong&gt; → línea doble en ÁREA.&lt;/li&gt;&lt;li&gt;¿Puede existir un comercial que no sea jefe? &lt;strong&gt;Sí&lt;/strong&gt; (“no todos son jefes”) → línea simple en COMERCIAL.&lt;/li&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;B9, TIENE (Gestión–Cliente)&lt;/strong&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;u&gt;9. Toda gestión está asociada a un cliente&amp;nbsp;&lt;br&gt;&lt;/u&gt;&lt;li&gt;¿Puede existir una gestión sin cliente? &lt;strong&gt;No&lt;/strong&gt; → línea doble en GESTIÓN.&lt;/li&gt;&lt;li&gt;¿Puede existir un cliente sin gestiones? B9 no dice que no, así que &lt;strong&gt;sí&lt;/strong&gt; → línea simple en CLIENTE.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="560" x="917" y="235" as="geometry" />
        </mxCell>
